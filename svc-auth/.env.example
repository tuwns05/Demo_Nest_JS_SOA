# Cổng HTTP của dịch vụ xác thực; JWT và thông tin máy chủ SQL dùng .env gốc.
PORT=3004
# Database riêng; thông tin máy chủ và xác thực SQL kế thừa .env gốc.
DB_NAME=SOA_AUTH
GOOGLE_CLIENT_ID=
SERVICE_URL_SINHVIEN=http://localhost:3001
# SMTP server used for one-time email codes (e.g. Gmail app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

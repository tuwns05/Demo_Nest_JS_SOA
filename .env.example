# Máy chủ SQL Server; bắt buộc điền đúng môi trường.
DB_HOST=
# Cổng TCP; để trống khi dùng named instance hoặc cổng mặc định của driver.
DB_PORT=
# Database đã tạo sẵn; bắt buộc điền.
DB_NAME=
# Named instance tùy chọn; không dùng đồng thời DB_PORT.
DB_INSTANCE=
# Tên ODBC driver đã cài trên máy.
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# Tài khoản SQL; bỏ cả user/password để dùng Windows Authentication.
DB_USER=
# Mật khẩu SQL; không commit giá trị thật.
DB_PASSWORD=
# Chuỗi ODBC ghi đè tùy chọn; vẫn cần DB_HOST và DB_NAME.
DB_CONNECTION_STRING=
# Khóa ngẫu nhiên dùng chung auth/gateway, tối thiểu 32 ký tự; bắt buộc điền.
JWT_SECRET=
# Thời hạn JWT; response expires_in dùng cùng giá trị.
JWT_EXPIRES_IN=15m

# Redis dùng chung cho svc-sinhvien và svc-detai; không commit mật khẩu thật.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=soa:
REDIS_COMMAND_TIMEOUT_MS=500
CACHE_DETAIL_TTL_MS=60000
CACHE_LIST_TTL_MS=30000
CACHE_JITTER_MS=5000
CACHE_LOCK_MS=10000
CACHE_WAIT_MS=2000
CACHE_RETRIES=30
CACHE_MAX_LOAD_MS=35000

# Cổng HTTP của dịch vụ đăng ký; thông tin máy chủ SQL dùng .env gốc.
PORT=3003
# Database riêng; thông tin máy chủ và xác thực SQL kế thừa .env gốc.
DB_NAME=SOA_DANGKY
# URL gốc dùng bởi SinhVienClient.
SERVICE_URL_SINHVIEN=http://localhost:3001
# URL gốc dùng bởi DeTaiClient.
SERVICE_URL_DETAI=http://localhost:3002
